# Shared secret for all three webhooks. Your CRM sends it in the X-Webhook-Secret header.
# Make up a long random string. If this is empty, every request is refused.
WEBHOOK_SECRET=make-up-a-long-random-string

# ClickUp (avatar → Settings → Apps → API Token). Personal tokens start with pk_ and are sent without "Bearer".
CLICKUP_API_TOKEN=pk_12345678_REPLACEWITHYOURTOKEN
# The list that holds your deals: the number after /li/ in the list's URL
CLICKUP_LIST_ID=901100200300
# Two Text custom fields on that list. Get their IDs from GET https://api.clickup.com/api/v2/list/{list_id}/field
CLICKUP_DEAL_ID_FIELD_ID=00000000-0000-4000-8000-000000000001
CLICKUP_MILESTONE_FIELD_ID=00000000-0000-4000-8000-000000000002

# The people who get tasks and digests. clickup_id comes from GET https://api.clickup.com/api/v2/team,
# slack_id is the Slack member ID (profile → three dots → Copy member ID). slack_id is optional.
TEAM_MEMBERS=[{"name":"Jordan Lee","email":"jordan.lee@example.com","clickup_id":81000001,"slack_id":"U0JORDAN01"},{"name":"Casey Morgan","email":"casey.morgan@example.com","clickup_id":81000009,"slack_id":"U0CASEY009"}]
# The transaction coordinator, assigned to every deal. Must be in TEAM_MEMBERS. Leave empty if you have none.
TC_EMAIL=casey.morgan@example.com

# Deadline rules
TIMEZONE=America/Chicago
# Local time every deadline is due (24 hour clock). Default 17:00
DEADLINE_TIME=17:00
# Move a deadline that falls on a weekend or holiday to the next business day. Default true
ROLL_TO_BUSINESS_DAY=true
# Optional: holidays that count as non business days, YYYY-MM-DD, comma separated
HOLIDAYS=2026-11-11,2026-11-26,2026-12-25

# Daily digest
# Overdue items plus everything due within this many days. Default 7
DIGEST_DAYS=7
# Ignore overdue items older than this many days. Default 60
DIGEST_OVERDUE_DAYS=60
# slack, email, or slack,email (default). Every channel listed here needs its keys below, or the digest stops with a 500.
DIGEST_CHANNELS=slack,email
# Slack app bot token with the chat:write scope (sends each person a direct message)
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Resend (resend.com → API Keys) and a sender on a domain you verified there
EMAIL_API_KEY=re_your_resend_api_key
EMAIL_FROM=Deal Desk <deals@yourbrokerage.example.com>

# Optional: Slack incoming webhook for failure alerts (used by workflow/error-alert-slack.json)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Self-hosted n8n must allow $env access in nodes
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
